local function updateHudData()
    _stats.boss = "Nenhum"
    local enemySeen = false
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj.ClassName ~= "Model" then continue end
        local hum = obj:FindFirstChildOfClass("Humanoid")
        if not hum then continue end
        local key = obj:GetFullName()
        if hum.Health <= 0 then
            if _wasAlive[key] then
                _stats.kills = _stats.kills + 1
                _wasAlive[key] = false
            end
            continue
        end
        if PService:GetPlayerFromCharacter(obj) then continue end
        _wasAlive[key] = true
        enemySeen = true
        local n = string.lower(obj.Name)
        if _stats.boss == "Nenhum" then
            for bossKey, bossName in pairs(BossIDs) do
                if string.find(n, bossKey, 1, true) then
                    _stats.boss = bossName
                    break
                end
            end
        end
        if _stats.dungeon == "Desconhecido" then
            for dname, keys in pairs(DungeonIDs) do
                for _, k in ipairs(keys) do
                    if string.find(n, k, 1, true) then
                        _stats.dungeon = dname
                        break
                    end
                end
                if _stats.dungeon ~= "Desconhecido" then break end
            end
        end
    end
    if enemySeen then
        _lastEnemySeenTime = tick()
    elseif (tick() - _lastEnemySeenTime) > 8 and _stats.dungeon ~= "Desconhecido" then
        _stats.dungeon = "Desconhecido"
    end
end

