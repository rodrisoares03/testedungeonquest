function applySnapshot(data)
    if type(data) ~= "table" then return end

    -- Se AutoF ativo na config: Spammer → Auto-F → 2s → resto da config
    if data.AutoFAtivo then
        -- 1) Dados basicos (necessarios para o spammer funcionar)
        if data.VelocidadeExtra ~= nil then NightHub.VelocidadeExtra = data.VelocidadeExtra end
        if data.FlightSpeed ~= nil then NightHub.FlightSpeed = data.FlightSpeed; UpdateSlider("Velocidade do Farm", data.FlightSpeed) end
        if data.FlySpeed ~= nil then NightHub.FlySpeed = data.FlySpeed end
        if data.FixedDepth ~= nil then NightHub.FixedDepth = data.FixedDepth; UpdateSlider("Profundidade", data.FixedDepth) end
        if data.MaxDetectionRange ~= nil then NightHub.MaxDetectionRange = data.MaxDetectionRange; UpdateSlider("Alcance de Detecção", data.MaxDetectionRange) end
        if data.HitboxSize ~= nil then NightHub.HitboxSize = data.HitboxSize; UpdateSlider("Tamanho do Hitbox", data.HitboxSize) end
        if data.AutoFDelay ~= nil then NightHub.AutoFDelay = data.AutoFDelay; UpdateSlider("Delay Auto-F", data.AutoFDelay) end
        if type(data.Binds) == "table" then
            for k, v in pairs(data.Binds) do
                if Binds[k] ~= nil then Binds[k] = v end
            end
        end

        -- 2) Spammer primeiro
        if data.SpammerAtivo then
            NightHub.SpammerAtivo = true
            UpdateUIToggle("Spammer", true)
            pcall(iniciarSpammer)
        end

        -- 3) Auto-F depois
        task.delay(0.5, function()
            NightHub.AutoFAtivo = true
            UpdateUIToggle("AutoF", true)
            pcall(iniciarAutoF)

            -- 4) Após 2 segundos, aplica o resto da config
            task.delay(2, function()
                -- Variaveis de dados
                if data.OcultarNome ~= nil then NightHub.OcultarNome = data.OcultarNome end
                if data.NomePersonalizado ~= nil then NightHub.NomePersonalizado = data.NomePersonalizado end
                if data.MostrarHUD ~= nil then NightHub.MostrarHUD = data.MostrarHUD end
                if data.NoVFXAtivo ~= nil then NightHub.NoVFXAtivo = data.NoVFXAtivo end
                if data.OrbitMode ~= nil then NightHub.OrbitMode = data.OrbitMode end
                if data.AoeFarmAtivo ~= nil then NightHub.AoeFarmAtivo = data.AoeFarmAtivo end
                if data.LeapingStepDistance ~= nil then NightHub.LeapingStepDistance = data.LeapingStepDistance end
                if data.LeapingStableTime ~= nil then NightHub.LeapingStableTime = data.LeapingStableTime end
                if data.LeapingStrikeTPDodge ~= nil then
                    NightHub.LeapingStrikeTPDodge = data.LeapingStrikeTPDodge
                    UpdateUIToggle("LeapingStrikeTPDodge", NightHub.LeapingStrikeTPDodge)
                end

                if type(data.AutoSellSettings) == "table" then
                    for cat, rarities in pairs(data.AutoSellSettings) do
                        if AutoSellSettings[cat] then
                            for rar, val in pairs(rarities) do
                                if AutoSellSettings[cat][rar] ~= nil then
                                    AutoSellSettings[cat][rar] = val
                                end
                            end
