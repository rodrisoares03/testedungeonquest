local function fastScanNPCs(charFilter, originPos, maxRange)
    local now = tick()
    if not ((now - _npcScanCacheTime) < 0.5 and #_npcScanCache > 0) then
        _npcScanCache = {}

        local playerChars = {}
        for _, player in ipairs(Players:GetPlayers()) do
            if player.Character then
                playerChars[player.Character] = true
            end
        end

        local function scanFolder(folder, depth)
            if depth > 4 then return end
            for _, obj in ipairs(folder:GetChildren()) do
                if _skipNames[obj.Name] then continue end
                local cn = obj.ClassName
                if cn == "Folder" then
                    scanFolder(obj, depth + 1)
                elseif cn == "Model" then
                    if playerChars[obj] then continue end
                    local hum = obj:FindFirstChildOfClass("Humanoid")
                    if hum then
                        local root = obj:FindFirstChild("HumanoidRootPart") or obj.PrimaryPart
                        if root and hum.Health > 0 and root:IsA("BasePart") then
                            local rp = root.Position
                            if rp.X == rp.X and rp.Y == rp.Y and rp.Z == rp.Z then
                                if not charFilter or obj ~= charFilter then
                                    _npcScanCache[#_npcScanCache + 1] = { model = obj, root = root, hum = hum }
                                end
                            end
                        end
                    end
                end
            end
        end
        scanFolder(workspace, 0)
        _npcScanCacheTime = now
    end
    local result = {}
    for i = 1, #_npcScanCache do
        local npc = _npcScanCache[i]
        if npc.root.Parent and npc.hum.Health > 0 then
            if originPos and maxRange then
                if (npc.root.Position - originPos).Magnitude <= maxRange then
                    result[#result + 1] = npc
                end
            else
                result[#result + 1] = npc
            end
        end
    end
    return result
end

local function getLowestPartY(model)
	if not model then return nil end
	local key = model:GetFullName()
	local c = _lowestYCache[key]
	if c and (tick() - c.t) < 2 then return c.v end
	local lowestY = nil
	local hrp = model:FindFirstChild("HumanoidRootPart")
	for _, part in ipairs(model:GetDescendants()) do
		if part:IsA("BasePart") then
			local y = part.Position.Y - part.Size.Y / 2
			if not lowestY or y < lowestY then
				lowestY = y
			end
		end
	end
	if not lowestY and hrp then
		lowestY = hrp.Position.Y - hrp.Size.Y / 2
	end
	_lowestYCache[key] = { v = lowestY, t = tick() }
	return lowestY
end

local function getGroundYAt(model, fallbackY, atPos)
	if not model then return fallbackY end
	local base = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart")
	if not base then return fallbackY end
	local castPos = atPos or base.Position
	-- Cache por célula do chão: evita o tremer do Y (chão recalculado a cada frame = "voadela" vertical)
	if atPos then
		local ck = ("%d,%d"):format(math.floor(castPos.X / 4), math.floor(castPos.Z / 4))
		local c = _groundYCache[ck]
		if c and (tick() - c.t) < NightHub.LeapingStableTime then return c.v end
	end
	local found = false
	pcall(function()
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		local filter = { model }
		local char = LocalPlayer.Character
		if char then filter[#filter + 1] = char end
		params.FilterDescendantsInstances = filter
		local origin = Vector3.new(castPos.X, castPos.Y + 8, castPos.Z)
		local pos = origin
		for _ = 1, 8 do
			local result = workspace:Raycast(pos, Vector3.new(0, -2000, 0), params)
			if not result then break end
			local inst = result.Instance
			if inst and inst:IsA("BasePart") and inst.CanCollide then
				fallbackY = result.Position.Y + 1
				found = true
				break
			end
			local sizeY = (inst and inst:IsA("BasePart") and inst.Size.Y) or 10
			pos = result.Position + Vector3.new(0, -(sizeY / 2) - 1, 0)
		end
	end)
	if not found then
		local lowest = getLowestPartY(model)
		if lowest and lowest < base.Position.Y then
			fallbackY = lowest
		else
			fallbackY = base.Position.Y - 5
		end
	end
	if atPos then
		local ck = ("%d,%d"):format(math.floor(castPos.X / 4), math.floor(castPos.Z / 4))
		_groundYCache[ck] = { v = fallbackY, t = tick() }
	end
	return fallbackY
end

