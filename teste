-- =========================================================================
-- MODO LIMBO / SEGURANÇA (volta para posição segura ao cair no vazio)
-- Funciona em qualquer modo (Farm, Fly, LeapingStrike TP, parado): se o
-- personagem cair para o vazio ou sair dos limites do mapa, teleporta de
-- volta para a última posição segura registrada.
-- =========================================================================
NightHub.LimboSafePos = nil
NightHub.LimboLastStore = 0

function iniciarLimbo()
    if Connections.LimboLoop then return end
    local function limboPosValida(pos)
        if not pos then return false end
        if pos.X ~= pos.X or pos.Y ~= pos.Y or pos.Z ~= pos.Z then return false end
        if pos.Y > 1000 or pos.Y < -800 then return false end
        if pos.Magnitude > 50000 then return false end
        return true
    end
    Connections.LimboLoop = RunService.Heartbeat:Connect(function()
        if not NightHub.LimboAtivo then return end
        pcall(function()
            local char = LocalPlayer.Character
            if not char then return end
            local root = char:FindFirstChild("HumanoidRootPart") or char.PrimaryPart
            if not root or not root:IsA("BasePart") then return end
            local pos = root.Position
            local now = tick()

            -- Registra a posição atual como segura (quando está dentro dos limites)
            if limboPosValida(pos) then
                if (now - NightHub.LimboLastStore) >= NightHub.LimboSafeRefresh then
                    NightHub.LimboLastStore = now
                    NightHub.LimboSafePos = pos
                end
            end

            -- Detecta limbo/vazio: fora dos limites OU abaixo da altura configurada
            local emLimbo = not limboPosValida(pos) or pos.Y < NightHub.LimboAltura
            if not emLimbo then
                -- Queda rápida abaixo do piso mais profundo (caiu do mapa em alta velocidade)
                local vel = root.AssemblyLinearVelocity
                if vel and vel.Y < -200 and pos.Y < -650 then
                    emLimbo = true
                end
            end

            if emLimbo then
                local destino = NightHub.LimboSafePos
                if not (destino and limboPosValida(destino)) then
                    local spawn = workspace:FindFirstChildWhichIsA("SpawnLocation")
                    if spawn then
                        destino = spawn.Position + Vector3.new(0, 4, 0)
                    else
                        destino = Vector3.new(0, 50, 0)
                    end
                end
                root.CFrame = CFrame.new(destino.X, destino.Y + 3, destino.Z)
                pcall(function()
                    local bv = root:FindFirstChild("BodyVelocity")
                    if bv then bv.Velocity = Vector3.new() end
                end)
            end
        end)
    end)
end

function pararLimbo()
    NightHub.LimboAtivo = false
    if Connections.LimboLoop then
        pcall(Connections.LimboLoop.Disconnect, Connections.LimboLoop)
        Connections.LimboLoop = nil
    end
end

local function montarInterface()
function iniciarNameChanger()
    local playerGui = LocalPlayer:WaitForChild("PlayerGui")
    local function scan(root) for _, descendant in ipairs(root:GetDescendants()) do pcall(applyToTextLabel, descendant) end end
    scan(playerGui)
    playerGui.DescendantAdded:Connect(function(descendant) task.wait(); pcall(applyToTextLabel, descendant) end)
    local function monitorCharacter(char) if not char then return end scan(char) char.DescendantAdded:Connect(function(descendant) task.wait(); pcall(applyToTextLabel, descendant) end) end
    monitorCharacter(LocalPlayer.Character)
    LocalPlayer.CharacterAdded:Connect(monitorCharacter)
end

