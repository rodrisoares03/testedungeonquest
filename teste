    Connections.LeapingStrikeTP = RunService.Heartbeat:Connect(function()
        if not NightHub.LeapingStrikeTPAtivo then return end
        pcall(function()
            local char = LocalPlayer.Character
            local rootPart = char and char:FindFirstChild("HumanoidRootPart")
            local humanoid = char and char:FindFirstChildOfClass("Humanoid")
            if not rootPart then return end

            if not dungeonStarted then
                tpBV.Parent = rootPart
                tpBG.Parent = rootPart
                tpBV.Velocity = Vector3.new(0, 0, 0)
                tpBG.CFrame = CFrame.new(rootPart.Position, rootPart.Position + rootPart.CFrame.LookVector)
                return
            end
            if ForceClickActive then return end

            -- Segurança: se o personagem estiver numa posição absurda (fora dos
            -- limites do mapa, ex: 6530, 17096, 88326), volta para a última
            -- posição segura conhecida (ou um ponto seguro fixo) e re-engaja o alvo.
            local _safeNow = rootPart.Position
            local _badNow = _safeNow.X ~= _safeNow.X or _safeNow.Y ~= _safeNow.Y or _safeNow.Z ~= _safeNow.Z
                or _safeNow.Y > 1000 or _safeNow.Y < -800 or _safeNow.Magnitude > 50000
            if _badNow then
                local _restore = _lastSafeTPPos
                if not (_restore and _restore.X == _restore.X and _restore.Y > -800
                    and _restore.Y < 1000 and _restore.Magnitude <= 50000) then
                    _restore = BossPositions["Adelys"].pos
                end
                if _restore then
                    rootPart.CFrame = CFrame.new(_restore.X, _restore.Y, _restore.Z)
                end
                return
            end
            if (tick() - _lastSafeStore) > 2 then
                _lastSafeStore = tick()
                _lastSafeTPPos = _safeNow
            end

            -- Ataque em área (Abyssal Void): opcional (LeapingStrikeTPDodge no menu).
            -- Desativado por padrão porque o scan de indicadores pesa no FPS e pode
            -- prender o TP do alvo se o mapa tiver decorações parecidas com AOE.
            if NightHub.LeapingStrikeTPDodge and not rotaYokaiPeakAtiva() then
                if tick() < _tpDodgeUntil then
                    tpBV.Parent = rootPart
                    tpBV.Velocity = Vector3.new(0, 0, 0)
                    tpBG.Parent = nil
                    return
                end
                if tick() >= _tpDodgeCheckAt then
                    _tpDodgeCheckAt = tick() + 0.15
                    local dodgePos = getDodgePosition(rootPart)
                    if dodgePos then
                        _tpDodgeUntil = tick() + 0.35
                        tpBV.Parent = rootPart
                        tpBV.Velocity = Vector3.new(0, 0, 0)
                        tpBG.Parent = nil
                        rootPart.CFrame = CFrame.new(dodgePos, dodgePos + Vector3.new(1, 0, 0))
                        return
                    end
                end
            end

            if _stats.dungeon == "Abyssal Void" and waitingForVoidborn then
                tpBV.Parent = rootPart
                tpBG.Parent = rootPart
                tpBV.Velocity = Vector3.new(0, 0, 0)
                local bPos = BossPositions["The Voidborn"].pos
                rootPart.CFrame = CFrame.new(bPos.X, bPos.Y, bPos.Z)
                if (tick() - voidbornWaitStart) >= 5 then
                    waitingForVoidborn = false
                end
                return
            end

            if _stats.dungeon == "Abyssal Void" and currentBoss == "The Voidborn" then
                tpBV.Parent = rootPart
                tpBV.Velocity = Vector3.new(0, 0, 0)
                local bPos = BossPositions["The Voidborn"].pos
                rootPart.CFrame = CFrame.new(bPos.X, bPos.Y, bPos.Z)
                return
            end

            local info = currentTargetInfo

            if rotaYokaiPeakAtiva() then
                -- ===================== YOKAI PEAK (inalterado) =====================
                -- Waypoint de arena: sem alvo (boss ainda não spawnou), avança na direção da arena conhecida
                if info.waypointPos then
                    local wp = info.waypointPos
                    if wp.X ~= wp.X or wp.Y ~= wp.Y or wp.Z ~= wp.Z then return end
                    local wpDist = (wp - rootPart.Position).Magnitude
                    local wpLimit = rotaYokaiPeakAtiva() and YOKAI_ROUTE_LIMIT or BOSS_SCAN_RANGE
                    if wpDist <= wpLimit then
                        tpBV.Parent = rootPart
                        tpBV.Velocity = Vector3.new(0, 0, 0)
                        if wpDist > 0.5 then
                            local dir = (wp - rootPart.Position).Unit
                            local dest = wp
                            if wpDist > NightHub.LeapingStepDistance then
                                dest = rootPart.Position + dir * NightHub.LeapingStepDistance
                            end
                            if dest.Y > -800 and dest.Y < 1000 then
                                tpBG.Parent = nil
                                rootPart.CFrame = CFrame.new(dest, dest + dir)
                                if (tick() - _lastSafeStore) > 2 then
                                    _lastSafeStore = tick()
                                    _lastSafeTPPos = rootPart.Position
                                end
                            end
                        else
                            -- Chegou à localização: mantém-se parado (sem CFrame degenerado)
                            tpBG.Parent = rootPart
                            tpBG.CFrame = CFrame.new(wp, wp + Vector3.new(0, 0, 1))
                            rootPart.CFrame = CFrame.new(wp, wp + Vector3.new(0, 0, 1))
                        end
                    end
                    return
                end

                -- Recuperação: se o jogador caiu para o vazio/limbo sem alvo, volta para a última posição válida
                if (tick() - _lastLimboCheck) > 1 then
                    _lastLimboCheck = tick()
                    local pPos = rootPart.Position
                    if pPos.Y < -400 and not (info.closestNPC and info.closestNPC.Parent) then
                        if _lastSafeTPPos then
                            rootPart.CFrame = CFrame.new(_lastSafeTPPos)
                        end
                        return
                    end
                end

                if info.closestNPC and info.closestNPC.Parent and info.closestNPCModel.Parent then
                    local now = tick()
                    local npcPos = info.closestNPC.Position
                    local npcCFrame = info.closestNPC.CFrame
                    if not npcPos or not npcCFrame then return end

                    -- Guarda anti-limbo: alvo muito além do alcance de deteção = posição stale, não faz TP
                    local allowRange = NightHub.MaxDetectionRange * 1.5
                    if info.bossName then
                        allowRange = rotaYokaiPeakAtiva() and YOKAI_ROUTE_LIMIT or BOSS_SCAN_RANGE
                    elseif not rotaYokaiPeakAtiva() then
                        allowRange = math.huge
                    end
                    if (npcPos - rootPart.Position).Magnitude > allowRange then
                        return
                    end

                    -- Regista a posição atual como segura (para recuperar de limbo)
                    if (now - _lastSafeStore) > 2 then
                        _lastSafeStore = now
                        _lastSafeTPPos = rootPart.Position
                    end

                    tpBV.Parent = rootPart
                    tpBV.Velocity = Vector3.new(0, 0, 0)
                    tpBG.Parent = nil

                    local function safeCFrame(pos, lookAt)
                        if pos.Y > 1000 or pos.Y < -800 then return nil end
                        if pos.Magnitude > 50000 then return nil end
                        if pos.X ~= pos.X or pos.Y ~= pos.Y or pos.Z ~= pos.Z then return nil end
                        return CFrame.new(pos, lookAt)
                    end

                    local lowestY = getLowestPartY(info.closestNPCModel) or npcPos.Y - 3
                    local baseY = math.max(lowestY, npcPos.Y - 5)
                    local groundY = baseY
                    local baseOrigin = Vector3.new(npcPos.X, groundY, npcPos.Z)

                    local flatLook = Vector3.new(npcCFrame.LookVector.X, 0, npcCFrame.LookVector.Z)
                    if flatLook.Magnitude > 0 then flatLook = flatLook.Unit else flatLook = Vector3.new(0, 0, 1) end

                    local flatRight = Vector3.new(npcCFrame.RightVector.X, 0, npcCFrame.RightVector.Z)
                    if flatRight.Magnitude > 0 then flatRight = flatRight.Unit else flatRight = Vector3.new(1, 0, 0) end

                    local function isSafePos(pos)
                        if not pos then return false end
                        if pos.X ~= pos.X or pos.Y ~= pos.Y or pos.Z ~= pos.Z then return false end
                        if pos.Y > 1000 or pos.Y < -800 then return false end
                        if pos.Magnitude > 50000 then return false end
                        return true
                    end

                    local function applyTP(pos, lookAt)
                        if not isSafePos(pos) then return end
                        -- Clamp por passo: nunca warp de mapa inteiro num frame, move-se em
                        -- passos suaves (mata a "voadela" de um lado para o outro).
                        local delta = pos - rootPart.Position
                        local maxStep = NightHub.LeapingStepDistance
                        if delta.Magnitude > maxStep and delta.Magnitude > 0.5 then
                            pos = rootPart.Position + delta.Unit * maxStep
                            if not isSafePos(pos) then return end
                        end
                        local lookPt = Vector3.new(lookAt.X, pos.Y, lookAt.Z)
                        if (pos - lookPt).Magnitude < 0.5 then
                            lookPt = pos + Vector3.new(0, 0, 1)
                        end
                        rootPart.CFrame = CFrame.new(pos, lookPt)
                    end

                    if info.bossName and BossPositions[info.bossName] then
                        local bPos = BossPositions[info.bossName].pos
                        if not rotaYokaiPeakAtiva() and isSafePos(bPos)
                            and (rootPart.Position - bPos).Magnitude <= BOSS_ENGAGE_RANGE then
                            applyTP(bPos, npcPos)
                        else
                            local safePos
                            if rotaYokaiPeakAtiva() then
                                safePos = getYokaiTPPos(-flatLook, baseOrigin, 25)
                            else
                                local dir = (-flatLook + flatRight * 0.4).Unit
                                safePos = baseOrigin + (dir * 25)
                            end
                            applyTP(safePos, npcPos)
                        end

                    elseif info.targetType == "Reaver" then
                        local dir = (-flatLook + flatRight * 0.6).Unit
                        local step = 18
                        local destX = npcPos.X + dir.X * step
                        local destZ = npcPos.Z + dir.Z * step
                        local groundY = getGroundYAt(info.closestNPCModel, baseY, Vector3.new(destX, baseY, destZ))
                        local safePos = Vector3.new(destX, math.max(groundY, baseY - 10), destZ)
                        applyTP(safePos, npcPos)

                    elseif info.targetType == "CorruptedGrowth" and info.closestNPCModel then
                        local awayDir = (rootPart.Position - npcPos)
                        awayDir = Vector3.new(awayDir.X, 0, awayDir.Z)
                        if awayDir.Magnitude < 1 then
                            awayDir = Vector3.new(1, 0, 0)
                        end
                        awayDir = awayDir.Unit
                        local destX = npcPos.X + awayDir.X * 50
                        local destZ = npcPos.Z + awayDir.Z * 50
                        local destPos = Vector3.new(destX, baseY, destZ)
                        local groundY = getGroundYAt(info.closestNPCModel, baseY, destPos)
                        local safePos = Vector3.new(destX, groundY, destZ)
                        if tick() - _lastCGDebug > 1 then
                            _lastCGDebug = tick()
                            print("[CG-TP] npcY=" .. tostring(npcPos.Y) .. " baseY=" .. tostring(baseY) .. " groundY=" .. tostring(groundY) .. " dest=" .. tostring(safePos))
                        end
                        applyTP(safePos, npcPos)

                    elseif info.targetType == "Voidshade" then
                        -- Fica ATRÁS do Voidshade (oposto ao look vector): ele vira para
                        -- o jogador a cada frame, por isso o destino alterna de lado e
                        -- assim o jogador desvia dos ataques frontais automaticamente.
                        local dir = (-flatLook + flatRight * 0.8).Unit
                        local safePos = baseOrigin + (dir * 15)
                        applyTP(safePos, npcPos)

                    elseif info.targetType == "Gregg" then
                        local dir = (-flatLook + flatRight * 0.8).Unit
                        local safePos = baseOrigin + (dir * 6)
                        applyTP(safePos, npcPos)

                    else
                        -- Alvos normais (não-boss): TP atrás do NPC (oposto ao look
                        -- vector) para o dano contar e para não ficar em cima dele.
                        local safePos
                        if rotaYokaiPeakAtiva() then
                            safePos = getYokaiTPPos(-flatLook, baseOrigin, 25)
                        else
                            local dir = (-flatLook + flatRight * 0.4).Unit
                            safePos = baseOrigin + (dir * 10)
                        end
                        applyTP(safePos, npcPos)
                    end
                else
                    tpBV.Parent = rootPart
                    tpBG.Parent = rootPart
                    tpBV.Velocity = Vector3.new(0, 0, 0)
                    tpBG.CFrame = CFrame.new(rootPart.Position, rootPart.Position + rootPart.CFrame.LookVector)
                end
            else
                -- ===================== ABYSSAL VOID (idêntico ao testeDQ.lua) =====================
                if info.closestNPC and info.closestNPC.Parent and info.closestNPCModel.Parent then
                    local now = tick()
                    local npcPos = info.closestNPC.Position
                    local npcCFrame = info.closestNPC.CFrame
                    if not npcPos or not npcCFrame then return end

                    tpBV.Parent = rootPart
                    tpBV.Velocity = Vector3.new(0, 0, 0)
                    tpBG.Parent = nil

                    local function safeCFrame(pos, lookAt)
                        if pos.Y > 1000 or pos.Y < -800 then return nil end
                        if pos.Magnitude > 50000 then return nil end
                        if pos.X ~= pos.X or pos.Y ~= pos.Y or pos.Z ~= pos.Z then return nil end
                        return CFrame.new(pos, lookAt)
                    end

                    local lowestY = getLowestPartY(info.closestNPCModel) or npcPos.Y - 3
                    local baseY = math.max(lowestY, npcPos.Y - 5)
                    local groundY = baseY
                    local baseOrigin = Vector3.new(npcPos.X, groundY, npcPos.Z)

                    local flatLook = Vector3.new(npcCFrame.LookVector.X, 0, npcCFrame.LookVector.Z)
                    if flatLook.Magnitude > 0 then flatLook = flatLook.Unit else flatLook = Vector3.new(0, 0, 1) end

                    local flatRight = Vector3.new(npcCFrame.RightVector.X, 0, npcCFrame.RightVector.Z)
                    if flatRight.Magnitude > 0 then flatRight = flatRight.Unit else flatRight = Vector3.new(1, 0, 0) end

                    local function isSafePos(pos)
                        if not pos then return false end
                        if pos.X ~= pos.X or pos.Y ~= pos.Y or pos.Z ~= pos.Z then return false end
                        if pos.Y > 1000 or pos.Y < -800 then return false end
                        if pos.Magnitude > 50000 then return false end
                        return true
                    end

                    -- Evita o "ping-pong": depois de desviar, o TP do alvo não pode
                    -- voltar para dentro de uma zona de AOE ainda ativa.
                    local function isInDangerZone(pos)
                        if not pos then return true end
                        if tick() > _lastDodgeDangersUntil then return false end
                        local dangers = _lastDodgeDangers
                        if not dangers then return false end
                        for _, d in ipairs(dangers) do
                            local dx = pos.X - d.center.X
                            local dz = pos.Z - d.center.Z
                            if math.sqrt(dx * dx + dz * dz) < d.radius + PLAYER_RADIUS + 1 then
                                return true
                            end
                        end
                        return false
                    end

                    local function isSafeTpPos(pos)
                        return isSafePos(pos) and not isInDangerZone(pos)
                    end

                    if info.bossName == "Adelys" then
                        local bPos = BossPositions["Adelys"].pos
                        if isSafeTpPos(bPos) then rootPart.CFrame = CFrame.new(bPos.X, bPos.Y, bPos.Z) end

                    elseif info.bossName == "The Voidborn" then
                        local bPos = BossPositions["The Voidborn"].pos
                        if isSafeTpPos(bPos) then rootPart.CFrame = CFrame.new(bPos.X, bPos.Y, bPos.Z) end

                    elseif info.targetType == "Reaver" then
                        local dir = (-flatLook + flatRight * 0.6).Unit
                        local step = 18
                        local destX = npcPos.X + dir.X * step
                        local destZ = npcPos.Z + dir.Z * step
                        local groundY = getGroundYAt(info.closestNPCModel, baseY, Vector3.new(destX, baseY, destZ))
                        local safePos = Vector3.new(destX, math.max(groundY, baseY - 10), destZ)
                        if isSafeTpPos(safePos) then rootPart.CFrame = CFrame.new(safePos, npcPos) end

                    elseif info.targetType == "CorruptedGrowth" and info.closestNPCModel then
                        local awayDir = (rootPart.Position - npcPos)
                        awayDir = Vector3.new(awayDir.X, 0, awayDir.Z)
                        if awayDir.Magnitude < 1 then
                            awayDir = Vector3.new(1, 0, 0)
                        end
                        awayDir = awayDir.Unit
                        local destX = npcPos.X + awayDir.X * 50
                        local destZ = npcPos.Z + awayDir.Z * 50
                        local destPos = Vector3.new(destX, baseY, destZ)
                        local groundY = getGroundYAt(info.closestNPCModel, baseY, destPos)
                        local safePos = Vector3.new(destX, groundY, destZ)
                        if tick() - _lastCGDebug > 1 then
                            _lastCGDebug = tick()
                            print("[CG-TP] npcY=" .. tostring(npcPos.Y) .. " baseY=" .. tostring(baseY) .. " groundY=" .. tostring(groundY) .. " dest=" .. tostring(safePos))
                        end
                        if isSafeTpPos(safePos) then rootPart.CFrame = CFrame.new(safePos, npcPos) end

                    elseif info.targetType == "Voidshade" then
                        local dir = (-flatLook + flatRight * 0.8).Unit
                        local safePos = baseOrigin + (dir * 15)
                        if isSafeTpPos(safePos) then rootPart.CFrame = CFrame.new(safePos, npcPos) end

                    elseif info.targetType == "Gregg" then
                        local dir = (-flatLook + flatRight * 0.8).Unit
                        local safePos = baseOrigin + (dir * 6)
                        if isSafeTpPos(safePos) then rootPart.CFrame = CFrame.new(safePos, npcPos) end

                    else
                        local dir = (-flatLook + flatRight * 0.4).Unit
                        local safePos = baseOrigin + (dir * 25)
                        if isSafeTpPos(safePos) then rootPart.CFrame = CFrame.new(safePos, npcPos) end
                    end
                else
                    tpBV.Parent = rootPart
                    tpBG.Parent = rootPart
                    tpBV.Velocity = Vector3.new(0, 0, 0)
                    tpBG.CFrame = CFrame.new(rootPart.Position, rootPart.Position + rootPart.CFrame.LookVector)
                end
            end
        end)
    end)

    -- Hitbox gigante em todos os NPCs: força o dano a contar (Voidshade e
    -- alvos em ângulos/sítios onde o ataque não conectava).
    Connections.LeapingStrikeTPHitbox = task.spawn(function()
        while NightHub.LeapingStrikeTPAtivo do
            pcall(function()
                local char = LocalPlayer.Character
                local npcList = fastScanNPCs(char, nil, nil)
                for _, npc in ipairs(npcList) do
                    local targetPart = npc.root
                    -- Gregg fica com o tamanho normal: hitbox gigante nele buga (teleporta).
                    -- O dano no Gregg vem do posicionamento próximo (offset menor no TP).
                    if string.find(string.lower(npc.model.Name), "gregg", 1, true) then continue end
                    if targetPart and targetPart:IsA("BasePart") and targetPart.Size.Y < NightHub.HitboxSize then
                        targetPart.Size = Vector3.new(NightHub.HitboxSize, NightHub.HitboxSize, NightHub.HitboxSize)
                        targetPart.Transparency = 1
                        targetPart.CanCollide = false
                    end
                end
            end)
            task.wait(1)
        end
    end)

    -- Travamento do Gregg no chão: impede que ele caia para baixo do mapa,
    -- mantendo-o colado à superfície do solo (sem anchor, para o dano contar).
    -- Leve e barato: só procura Greggs a ≤250 studs do jogador, e só corrige
    -- quando ele está claramente afundado (> 3 studs) — não luta com o jogo.
    Connections.LeapingStrikeTPGroundLock = task.spawn(function()
        while NightHub.LeapingStrikeTPAtivo do
            pcall(function()
                local char = LocalPlayer.Character
                local rootPart = char and (char:FindFirstChild("HumanoidRootPart") or char.PrimaryPart)
                if not rootPart then return end
                local playerPos = rootPart.Position
                local npcList = fastScanNPCs(char, playerPos, 250)
                for _, npc in ipairs(npcList) do
                    local model = npc.model
                    if string.find(string.lower(model.Name), "gregg", 1, true) then
                        local hrp = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
                        if hrp and hrp:IsA("BasePart") then
                            local pos = hrp.Position
                            local params = RaycastParams.new()
                            params.FilterType = Enum.RaycastFilterType.Exclude
                            local filter = { model }
                            if char then filter[#filter + 1] = char end
                            params.FilterDescendantsInstances = filter
                            local function groundAt(startY, downLen)
                                local r = workspace:Raycast(Vector3.new(pos.X, startY, pos.Z), Vector3.new(0, -downLen, 0), params)
                                if r and r.Instance and r.Instance:IsA("BasePart") and r.Instance.CanCollide then
                                    return r.Position.Y + 1
                                end
                                return nil
                            end
                            local groundY = groundAt(pos.Y + 100, 120)
                            if not groundY then groundY = groundAt(1000, 5000) end
                            if groundY and groundY > -800 and groundY < 1000 and pos.Y < groundY - 3 then
                                hrp.CFrame = CFrame.new(Vector3.new(pos.X, groundY, pos.Z))
                                pcall(function() hrp.AssemblyLinearVelocity = Vector3.new() end)
                            end
                        end
                    end
                end
            end)
            task.wait(0.25)
        end
    end)

    Connections.LeapingStrikeTPCleanup = function()
        if tpBV then tpBV:Destroy() end
        if tpBG then tpBG:Destroy() end
        if Connections.LeapingStrikeTP_Targeter then
            pcall(task.cancel, Connections.LeapingStrikeTP_Targeter)
            Connections.LeapingStrikeTP_Targeter = nil
        end
        if Connections.LeapingStrikeTPHitbox then
            pcall(task.cancel, Connections.LeapingStrikeTPHitbox)
            Connections.LeapingStrikeTPHitbox = nil
        end
        if Connections.LeapingStrikeTPGroundLock then
            pcall(task.cancel, Connections.LeapingStrikeTPGroundLock)
            Connections.LeapingStrikeTPGroundLock = nil
        end
    end
end

function pararLeapingStrikeTP()
    NightHub.LeapingStrikeTPAtivo = false
    currentZoneMap = nil
    currentZoneKeys = nil
    pcall(function()
        local char = LocalPlayer.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if hum then
            hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, true)
            hum.WalkSpeed = NightHub.OriginalWalkSpeed
        end
    end)
    if Connections.LeapingStrikeTPCleanup then
        pcall(Connections.LeapingStrikeTPCleanup)
        Connections.LeapingStrikeTPCleanup = nil
    end
    if Connections.LeapingStrikeTP then
        pcall(Connections.LeapingStrikeTP.Disconnect, Connections.LeapingStrikeTP)
        Connections.LeapingStrikeTP = nil
    end
end

