-- Função auxiliar: retorna a cor de uma raridade pelo key
local function getCorRaridade(rarKey)
    for _, r in ipairs(raridades) do
        if r.key == rarKey then return r.cor end
    end
    return Cores.TextoSecundario
end

-- Função auxiliar: retorna o label de uma raridade pelo key
local function getLabelRaridade(rarKey)
    for _, r in ipairs(raridades) do
        if r.key == rarKey then return r.label end
    end
    return rarKey
end

-- Atualiza a aparência visual de um botão de raridade
function atualizarBotaoRaridade(catKey, rarKey)
    local ref = SellRarityButtons[catKey] and SellRarityButtons[catKey][rarKey]
    if not ref then return end
    local ativo = AutoSellSettings[catKey] and AutoSellSettings[catKey][rarKey]
    local cor = getCorRaridade(rarKey)
    
    -- Tenta encontrar o Stroke se existir
    local stroke = ref:FindFirstChildOfClass("UIStroke")
    
    if ativo then
        ref.BackgroundColor3 = cor
        ref.TextColor3 = Color3.fromRGB(255, 255, 255)
        ref.BackgroundTransparency = 0
        if stroke then stroke.Transparency = 1 end
    else
        -- Quando desativado, fica cinza escuro e o texto fica com cor apagada
        ref.BackgroundColor3 = Color3.fromRGB(40, 40, 45)
        ref.TextColor3 = Color3.fromRGB(100, 100, 110)
        ref.BackgroundTransparency = 0.3
        if stroke then 
            stroke.Transparency = 0.5 
            stroke.Color = Color3.fromRGB(80, 80, 90)
        end
    end
end

