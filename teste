local function getVelocidadeExtra()
    if rotaYokaiPeakAtiva() then return NightHub.YokaiPeakSpeedMultiplier end
    return NightHub.SpeedMultiplier
end

-- Captura a velocidade base do personagem SEM capturar o valor já turbinado.
-- Evita o bug em que a 2x acumula (16 -> 32 -> 64...) quando o script é
-- autoexecutado ou o personagem respawna com a velocidade ainda boostada.
function atualizarVelocidadeBase(humanoid)
    if not humanoid then return NightHub.OriginalWalkSpeed end
    local atual = humanoid.WalkSpeed
    if atual <= 0 then return NightHub.OriginalWalkSpeed end
    local base = NightHub.OriginalWalkSpeed
    if base > 0 and atual >= base * 2 then
        return base
    end
    if atual < 100 then
        NightHub.OriginalWalkSpeed = atual
    end
    return NightHub.OriginalWalkSpeed
end

function ativarVelocidadeExtra()
    if Connections.SpeedLoop then Connections.SpeedLoop:Disconnect() end
    if Connections.SpeedCheck then pcall(task.cancel, Connections.SpeedCheck) end
    pcall(function()
        local char = LocalPlayer.Character
        if char and char:FindFirstChild("Humanoid") then
            local humanoid = char.Humanoid
            humanoid.WalkSpeed = NightHub.OriginalWalkSpeed * getVelocidadeExtra()
            Connections.SpeedLoop = humanoid:GetPropertyChangedSignal("WalkSpeed"):Connect(function()
                if NightHub.VelocidadeExtra and humanoid.WalkSpeed ~= NightHub.OriginalWalkSpeed * getVelocidadeExtra() then
                    humanoid.WalkSpeed = NightHub.OriginalWalkSpeed * getVelocidadeExtra()
                end
            end)
        end
    end)
    Connections.SpeedCheck = task.spawn(function()
        while NightHub.VelocidadeExtra do
            task.wait(1)
            pcall(function()
                local char = LocalPlayer.Character
                if char and char:FindFirstChild("Humanoid") then
                    local humanoid = char.Humanoid
                    local target = NightHub.OriginalWalkSpeed * getVelocidadeExtra()
                    if humanoid.WalkSpeed ~= target then
                        humanoid.WalkSpeed = target
                    end
                end
            end)
        end
    end)
end

function desativarVelocidadeExtra()
    if Connections.SpeedCheck then
        pcall(task.cancel, Connections.SpeedCheck)
        Connections.SpeedCheck = nil
    end
    Connections.SpeedLoop = nil
    pcall(function()
        local char = LocalPlayer.Character
        if char and char:FindFirstChild("Humanoid") then
            char.Humanoid.WalkSpeed = NightHub.OriginalWalkSpeed
        end
    end)
end

