local function equipLeapingStrike()
    local char = LocalPlayer.Character
    if not char then return false end

    for _, tool in ipairs(char:GetChildren()) do
        if tool:IsA("Tool") and tool.Name == "Leaping Strike" then
            NightHub.LeapingStrikeEquipped = true
            return true
        end
    end

    NightHub.LeapingStrikeEquipped = false
    return false
end

local function useLeapingStrikeBypass()
    local char = LocalPlayer.Character
    if not char then return end

    local leapingTool = nil
    for _, tool in ipairs(char:GetChildren()) do
        if tool:IsA("Tool") and tool.Name == "Leaping Strike" then
            leapingTool = tool
            break
        end
    end

    if not leapingTool then
        warn("[Bypass] Leaping Strike não está equipado — equipa manualmente.")
        return
    end

    NightHub.LeapingStrikeEquipped = true

    -- Simula clique real de tecla (VirtualInputManager)
    local VIM = game:GetService("VirtualInputManager")
    pcall(function()
        VIM:SendKeyEvent(true, Enum.KeyCode.E, false, game)
        task.wait(0.05)
        VIM:SendKeyEvent(false, Enum.KeyCode.E, false, game)
    end)

    print("[Bypass] Leaping Strike bypass ativo!")
end

-- =========================================================================
-- AUTO-F (LOOP: F → SLOT SECUNDARIO → FIRE TODAS AS ABILITIES → F → VOLTA)
-- Ao trocar para o secundario, as tools do secundario ficam no char
-- e as do primario ficam no backpack. Fire os remotes de TODAS as tools
-- nesse ponto para usar as 4 abilities de uma vez.
-- =========================================================================
function iniciarAutoF()
    if Connections.AutoFLoop then return end

    Connections.AutoFLoop = task.spawn(function()
        local VIM = game:GetService("VirtualInputManager")

        while NightHub.AutoFAtivo do
            NightHub.AutoFPressingF = true

            pcall(function()
                local char = LocalPlayer.Character
                if not char then return end

                -- === FASE 1: Leaping Strike ANTES de trocar (sem conflito) ===
                local ls = char:FindFirstChild("Leaping Strike")
                if ls and ls:IsA("Tool") then
                    for _, d in ipairs(ls:GetDescendants()) do
                        if d:IsA("RemoteEvent") and d.Parent then
                            pcall(function() d:FireServer() end)
                        end
                    end
                    task.wait(0.1)
                end

                -- === FASE 2: F para trocar para slots secundarios ===
                VIM:SendKeyEvent(true, Enum.KeyCode.F, false, game)
                task.wait(0.03)
                VIM:SendKeyEvent(false, Enum.KeyCode.F, false, game)
                task.wait(0.5)

                -- === FASE 3: Q (dano) no secundario ===
                for _ = 1, 3 do
                    pcall(function()
                        VIM:SendKeyEvent(true, Enum.KeyCode.Q, false, game)
                        task.wait(0.02)
                        VIM:SendKeyEvent(false, Enum.KeyCode.Q, false, game)
                    end)
                    task.wait(0.05)
                end

                -- === Espera do slot secundario ===
                task.wait(math.max(0.1, NightHub.AutoFDelay))

                -- === FASE 4: F para voltar ao slot principal ===
                VIM:SendKeyEvent(true, Enum.KeyCode.F, false, game)
                task.wait(0.03)
                VIM:SendKeyEvent(false, Enum.KeyCode.F, false, game)
                task.wait(0.3)

                NightHub.ForceToolCacheRebuild = true
            end)

            NightHub.AutoFPressingF = false

            if not NightHub.AutoFAtivo then break end
            task.wait(math.max(0.5, NightHub.AutoFDelay))
        end

        NightHub.AutoFPressingF = false
        Connections.AutoFLoop = nil
    end)
end

function pararAutoF()
    NightHub.AutoFAtivo = false
    NightHub.AutoFPressingF = false
    if Connections.AutoFLoop then
        pcall(task.cancel, Connections.AutoFLoop)
        Connections.AutoFLoop = nil
    end
end

