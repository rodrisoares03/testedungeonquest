local LeapingStrikeUsedOnce = false
local VIM = game:GetService("VirtualInputManager")
local ForceClickActive = false
local LeapingStrikeAutoUsed = false

local function toolTemAbilitySlot(tool)
    if not tool then return false end
    if tool.abilitySlot then return true end
    return tool:GetAttribute("abilitySlot") ~= nil
end

local function sendAbilityKey(key)
    local char = LocalPlayer.Character
    local equipped = char and char:FindFirstChildOfClass("Tool")
    if equipped and not toolTemAbilitySlot(equipped) then
        return
    end
    VIM:SendKeyEvent(true, key, false, game)
    task.wait(0.02)
    VIM:SendKeyEvent(false, key, false, game)
end

usarLeapingStrikeUmaVez = function()
    if LeapingStrikeAutoUsed then return end
    local char = LocalPlayer.Character
    if not char then return end
    local ls = char:FindFirstChild("Leaping Strike")
    if not (ls and ls:IsA("Tool")) then return end
    LeapingStrikeAutoUsed = true
    pcall(function()
        sendAbilityKey(Enum.KeyCode.E)
    end)
end

function forceClickQ()
    ForceClickActive = true
    task.spawn(function()
        pcall(function()
            sendAbilityKey(Enum.KeyCode.E)
        end)
    end)
    task.delay(0.2, function() ForceClickActive = false end)
end

function iniciarSpammer()
    if Connections.SpamLoop then return end
    LeapingStrikeUsedOnce = false
    LeapingStrikeAutoUsed = false

    task.defer(function()
        for _ = 1, 20 do
            if not NightHub.SpammerAtivo then return end
            usarLeapingStrikeUmaVez()
            if LeapingStrikeAutoUsed then return end
            task.wait(0.1)
        end
    end)

    _toolRemoteCache = {}
    _toolAnimCache = {}

    local toolsCache = {}
    local toolsCacheTime = 0

    Connections.SpamLoop = RunService.Heartbeat:Connect(function()
        if not NightHub.SpammerAtivo then return end

        pcall(function()
            local char = LocalPlayer.Character
            if not char then return end
            local bp = LocalPlayer:FindFirstChild("Backpack")
            local equipped = char:FindFirstChildOfClass("Tool")
            -- Spam contínuo: Q (dano) nunca pára; E só pausa com Leaping Strike equipada.
            local leapingEquipped = equipped and equipped.Name == "Leaping Strike"

            -- Stop animations para evitar locks
            pcall(function()
                local humanoid = char:FindFirstChildOfClass("Humanoid")
                if humanoid then
                    local animator = humanoid:FindFirstChildOfClass("Animator")
                    if animator then
                        for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
                            if track and track.IsPlaying then
                                track:Stop(0)
                            end
                        end
                    end
                end
            end)

            -- Triple Q spam (dano) — sempre ativo
            for _ = 1, 3 do
                pcall(function()
                    VIM:SendKeyEvent(true, Enum.KeyCode.Q, false, game)
                    VIM:SendKeyEvent(false, Enum.KeyCode.Q, false, game)
                end)
            end

            -- Triple E spam (heal) — só não dispara com a Leaping Strike equipada
            if not leapingEquipped then
                for _ = 1, 3 do
                    pcall(function()
                        VIM:SendKeyEvent(true, Enum.KeyCode.E, false, game)
                        VIM:SendKeyEvent(false, Enum.KeyCode.E, false, game)
                    end)
                end
            end

            -- Collect tools cache (rebuilt every 0.5s, ou imediatamente apos troca de slot)
            local now = tick()
            if now - toolsCacheTime > 0.5 or NightHub.ForceToolCacheRebuild then
                NightHub.ForceToolCacheRebuild = false
                toolsCacheTime = now
                toolsCache = {}
                for _, v in ipairs(char:GetChildren()) do
                    if v:IsA("Tool") then toolsCache[#toolsCache + 1] = v end
                end
                if bp then
                    for _, v in ipairs(bp:GetChildren()) do
                        if v:IsA("Tool") then toolsCache[#toolsCache + 1] = v end
                    end
                end
                -- Limpa cache de remotes para tools novas
                _toolRemoteCache = {}
                _toolAnimCache = {}
            end

            for ti = 1, #toolsCache do
                local tool = toolsCache[ti]
                if not tool.Parent then continue end
                if tool.Name ~= "Leaping Strike" then
                    local toolKey = tool:GetFullName()
                    if not _toolRemoteCache[toolKey] then
                        local rems = {}
                        local anims = {}
                        for _, d in ipairs(tool:GetDescendants()) do
                            if d:IsA("RemoteEvent") then rems[#rems + 1] = d end
                            if d:IsA("AnimationTrack") then anims[#anims + 1] = d end
                        end
                        _toolRemoteCache[toolKey] = rems
                        _toolAnimCache[toolKey] = anims
                    end
                    local anims = _toolAnimCache[toolKey]
                    if anims then
                        for i = 1, #anims do
                            local obj = anims[i]
                            if obj and obj.Parent and obj.IsPlaying then obj:Stop(0) end
                        end
                    end
                    if tool.Name == "Life Dash" then
                        for _, snd in ipairs(tool:GetDescendants()) do
                            if snd:IsA("Sound") then
                                snd.Volume = 0
                            end
                        end
                    end
                    -- tool:Activate() removido: disparava cooldown cíclico no jogo e
                    -- bloqueava a habilidade nova equipada (slots travados) com o spam ligado.
                    local rems = _toolRemoteCache[toolKey]
                    if rems then
                        for i = 1, #rems do
                            local d = rems[i]
                            if d and d.Parent then d:FireServer() end
                        end
                    end
                    -- Habilidade sem evento direto: ativa via dataRemoteEvent (Abilities), sem cooldown
                    local cooldownVal = tool:FindFirstChild("cooldown")
                    if cooldownVal and not (tool:FindFirstChild("abilityEvent") or tool:FindFirstChild("spellEvent")) then
                        if not dataRemoteEvent then
                            dataRemoteEvent = game:GetService("ReplicatedStorage"):FindFirstChild("dataRemoteEvent")
                        end
                        if dataRemoteEvent then
                            dataRemoteEvent:FireServer({ [1] = { [string.char(9)] = tool }, [2] = "G" })
                        end
                    end
                end
            end
        end)
    end)
end

function pararSpammer()
    if Connections.SpamLoop then
        pcall(function() Connections.SpamLoop:Disconnect() end)
        Connections.SpamLoop = nil
        NightHub.SpammerAtivo = false
    end
    _toolRemoteCache = {}
    _toolAnimCache = {}
end

