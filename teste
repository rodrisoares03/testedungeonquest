                local okLoad, cfgFunc = pcall(loadstring, configStr)
                if okLoad and cfgFunc then
                    local okCfg, cfg = pcall(cfgFunc)
                    if okCfg and type(cfg) == "table" then
                        applySnapshot(cfg)
                        refreshAllTextLabels()
                        for catKey, rarMap in pairs(AutoSellSettings) do
                            for rarKey, _ in pairs(rarMap) do
                                atualizarBotaoRaridade(catKey, rarKey)
                            end
                        end
                        showFeedback("Config importada com sucesso!")
                        return
                    end
                end
            end

            showFeedback("Loadstring não contém config válida!", true)
        end)
    end)
end

