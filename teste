-- Cores REAIS usadas pelo jogo na UI de venda (NÃO são as cores do hub).
-- Sem cor de "Ultimate": itens com raridade desconhecida nunca são vendidos.
AutoSellRarityCores = {
    ["legendary"] = Color3.fromRGB(244, 154, 9),
    ["epic"]      = Color3.fromRGB(146, 70, 159),
    ["rare"]      = Color3.fromRGB(75, 77, 195),
    ["uncommon"]  = Color3.fromRGB(91, 194, 80),
    ["common"]    = Color3.fromRGB(152, 152, 152),
}

-- Compara duas cores com tolerância (joga 0-255 → tolerância de 3 por canal).
-- Evita falsos positivos por arredondamento float do Roblox.
local function coresIguais(a, b, tol)
    tol = tol or 3
    local function c255(x) return math.floor(x * 255 + 0.5) end
    return math.abs(c255(a.R) - c255(b.R)) <= tol
       and math.abs(c255(a.G) - c255(b.G)) <= tol
       and math.abs(c255(a.B) - c255(b.B)) <= tol
end

-- Coleta os itens da UI de venda identificando raridade pela cor do item.
-- Retorna uma lista de { tipo, indice, raridade } apenas para itens cuja cor
-- bate com uma raridade conhecida (com tolerância de ±3 por canal RGB).
-- Itens sem correspondência ficam de fora e NUNCA são vendidos.
function coletarItensVenda()
    local sellShop = LocalPlayer.PlayerGui:FindFirstChild("sellShop")
    local frame = sellShop and sellShop:FindFirstChild("Frame")
    local innerFrame = frame and frame:FindFirstChild("innerFrame")
    local rightSide = innerFrame and innerFrame:FindFirstChild("rightSideFrame")
    local scrolling = rightSide and rightSide:FindFirstChild("ScrollingFrame")
    if not scrolling then return {} end
    local itens = {}
    for _, v in ipairs(scrolling:GetChildren()) do
        if v:IsA("ImageLabel") then
            local itemTypeObj = v:FindFirstChild("itemType")
            local uniqueNum = itemTypeObj and itemTypeObj:FindFirstChild("uniqueItemNum")
            if itemTypeObj and uniqueNum then
                local tipo = itemTypeObj.Value
                local indice = tonumber(uniqueNum.Value)
                if AutoSellSettings[tipo] and indice and indice > 0 then
                    local raridade = nil
                    for chave, cor in pairs(AutoSellRarityCores) do
                        if coresIguais(v.ImageColor3, cor) then
                            raridade = chave
                            break
                        end
                    end
                    if raridade then
                        table.insert(itens, { tipo = tipo, indice = indice, raridade = raridade })
                    end
                end
            end
        end
    end
    return itens
end

-- Executa UMA passada de venda respeitando as configurações atuais.
-- Só vende item cuja categoria E raridade estejam marcadas no AutoSellSettings.
-- Retorna a quantidade de itens enviados (0 se nada foi vendido).
function executarVendaAutomatica()
    local remotes = ReplicatedStorage:FindFirstChild("remotes")
    local sellEvent = remotes and remotes:FindFirstChild("sellItemEvent")
    if not sellEvent then return 0 end
    local args = { ["chest"] = {}, ["helmet"] = {}, ["ability"] = {}, ["ring"] = {}, ["weapon"] = {} }
    local contadores = { ["chest"] = 0, ["helmet"] = 0, ["ability"] = 0, ["ring"] = 0, ["weapon"] = 0 }
    local total = 0
    for _, item in ipairs(coletarItensVenda()) do
        local cfgCat = AutoSellSettings[item.tipo]
        if cfgCat and cfgCat[item.raridade] then
            contadores[item.tipo] = contadores[item.tipo] + 1
            args[item.tipo][contadores[item.tipo]] = item.indice
            total = total + 1
        end
    end
    if total > 0 then
        sellEvent:FireServer(args)
    end
    return total
end

function loopAutoSell()
    while NightHub.AutoSellAtivo do
        pcall(executarVendaAutomatica)
        task.wait(0.6)
    end
end

function iniciarAutoSell()
    local loop = NightHub.AutoSellLoop
    if loop and coroutine.status(loop) ~= "dead" then return end
    NightHub.AutoSellLoop = task.spawn(loopAutoSell)
end

function pararAutoSell()
    NightHub.AutoSellAtivo = false
    local loop = NightHub.AutoSellLoop
    NightHub.AutoSellLoop = nil
    if loop then
        pcall(task.cancel, loop)
    end
end

