function iniciarLeapingStrikeTP()
    if Connections.LeapingStrikeTP then return end

    local tpBV = Instance.new("BodyVelocity")
    tpBV.MaxForce = Vector3.new(1e6, 1e6, 1e6)
    tpBV.P = 10000
    tpBV.Velocity = Vector3.new(0, 0, 0)

    local tpBG = Instance.new("BodyGyro")
    tpBG.MaxTorque = Vector3.new(1e6, 1e6, 1e6)
    tpBG.P = 10000

    pcall(function()
        local freezeChar = LocalPlayer.Character
        if freezeChar then
            local freezeHum = freezeChar:FindFirstChildOfClass("Humanoid")
            if freezeHum then
                freezeHum.WalkSpeed = 0
            end
        end
    end)

    local hadTargets = false
    local greggSpawnTime = 0
    local greggLastSeenPart = nil
    local _lastLimboCheck = 0
    local _lastSafeStore = 0
    local _lastSafeTPPos = nil

    local currentTargetInfo = {
        bossName = nil,
        closestNPC = nil,
        closestNPCModel = nil,
        targetType = nil,
        isCorruptedGrowth = false,
        waypointPos = nil,
    }

    Connections.LeapingStrikeTP_Targeter = task.spawn(function()
        while NightHub.LeapingStrikeTPAtivo do
            pcall(function()
                if not dungeonStarted then return end

                local char = LocalPlayer.Character
                local rootPart = char and char:FindFirstChild("HumanoidRootPart")
                if not rootPart then return end

                if rotaYokaiPeakAtiva() then
                    -- ===================== YOKAI PEAK (inalterado) =====================
                    -- Yokai Peak: deteta quando o Leonaru (penúltimo boss) morre para
                    -- então guiar o TP até o Sarugami (boss final). A deteção varre o
                    -- mapa inteiro para funcionar mesmo se o Leonaru for morto à distância.
                    if rotaYokaiPeakAtiva() and not _yokaiLeonaruMorto then
                        local viuLeonaru = false
                        local scanLeonaru = fastScanNPCs(char)
                        for _, npc in ipairs(scanLeonaru) do
                            if string.find(string.lower(npc.model.Name), "commander leonaru", 1, true) then
                                viuLeonaru = true
                                break
                            end
                        end
                        if viuLeonaru then
                            _leonaruJaVisto = true
                        elseif _leonaruJaVisto then
                            _yokaiLeonaruMorto = true
                        end
                    end

                    local npcList = fastScanNPCs(char, rootPart.Position, rotaYokaiPeakAtiva() and NightHub.MaxDetectionRange or nil)

                    -- LIMPEZA SEQUENCIAL POR ZONAS: pega apenas o grupo de NPCs da zona
                    -- mais próxima e estaticamente ordenada, para NUNCA pular para um boss
                    -- final antes de chegar na arena dele (ex.: matar Tatsu e warp direto
                    -- para o Sarugami no Yokai Peak).
                    local candidates = npcList
                    do
                        local zones = buildZoneMap(npcList, rootPart.Position)
                        local zoneKeys = getSortedZoneKeys(zones)
                        if #zoneKeys > 0 then
                            local firstZone = zones[zoneKeys[1]]
                            if firstZone and firstZone.count > 0 then
                                candidates = firstZone.npcs
                            end
                        end
                    end

                    local voidbornTarget = nil
                    local adelysTarget = nil
                    local reaverTarget = nil
                    local reaverDist = math.huge
                    local normalNPC = nil
                    local normalDist = math.huge
                    local targetTypeNormal = "Normal"
                    local corruptedTarget = nil
                    local corruptedDist = math.huge
                    local greggTarget = nil
                    local greggDist = math.huge

                    -- Adelys só é atacado depois de todos os NPCs pré-boss morrerem.
                    local hasAliveAdds = false
                    for _, npc in ipairs(npcList) do
                        local nml = string.lower(npc.model.Name)
                        if string.find(nml, "the voidborn") then continue end
                        if string.find(nml, "adelys") then continue end
                        hasAliveAdds = true
                        break
                    end

                    -- Passo 1: bosses/alvos especiais (global, fora do filtro de zona)
                    local adelysPresent = false
                    for _, npc in ipairs(npcList) do
                        local model = npc.model
                        local targetPart = npc.root
                        local d = (targetPart.Position - rootPart.Position).Magnitude
                        local nameLower = string.lower(model.Name)

                        if string.find(nameLower, "the voidborn") then
                            voidbornTarget = { model = model, part = targetPart }
                        elseif string.find(nameLower, "adelys") then
                            adelysPresent = true
                            -- Só engaja o Adelys quando não há mais NPCs vivos e o
                            -- Adelys já está parado (não persegue o boss em movimento).
                            if not hasAliveAdds and isAdelysStationary(model) then
                                adelysTarget = { model = model, part = targetPart }
                            end
                        elseif isEldritchReaver(model.Name) then
                            if d < reaverDist then
                                reaverDist = d
                                reaverTarget = { model = model, part = targetPart }
                            end
                        elseif isCorruptedGrowth(model.Name) then
                            if d < corruptedDist then
                                corruptedDist = d
                                corruptedTarget = { model = model, part = targetPart }
                            end
                        end
                    end

                    -- Passo 2: NPC comum do grupo mais próximo (sequencial, sem pular salas)
                    local maxNormalRange = rotaYokaiPeakAtiva() and math.min(NightHub.MaxDetectionRange, 300) or math.huge
                    for _, npc in ipairs(candidates) do
                        local model = npc.model
                        local targetPart = npc.root
                        local nameLower = string.lower(model.Name)
                        -- Adelys nunca é tratado como NPC comum (mesmo a caminho da arena).
                        -- Gregg é um alvo do TP prioritário: quando spawna, vamos para
                        -- perto dele (o handler targetType "Gregg" desvia dos ataques).
                        if string.find(nameLower, "adelys")
                            or string.find(nameLower, "the voidborn")
                            or isEldritchReaver(model.Name) or isCorruptedGrowth(model.Name) then
                            continue
                        end
                        local d = (targetPart.Position - rootPart.Position).Magnitude
                        if string.find(nameLower, "gregg") then
                            if d < greggDist then
                                greggDist = d
                                greggTarget = { model = model, part = targetPart }
                            end
                            if d > maxNormalRange then continue end
                        elseif d > maxNormalRange then
                            continue
                        end
                        if d < normalDist then
                            normalDist = d
                            normalNPC = { model = model, part = targetPart }
                            if isVoidShade(model.Name) then
                                targetTypeNormal = "Voidshade"
                            else
                                targetTypeNormal = "Normal"
                            end
                        end
                    end

                    -- Passo 3: verificação de boss — sem alvo normal, procura o boss
                    -- (alcance alargado) e vai até ele em vez de ficar parado após o
                    -- último grupo de NPCs. No Yokai Peak mantém o alcance da rota.
                    local bossTarget = nil
                    local bossPosKey = nil
                    local bossDist = math.huge
                    local waypointPos = nil
                    if not voidbornTarget and not adelysTarget and not reaverTarget
                        and not normalNPC and not corruptedTarget then
                        local bossRange = rotaYokaiPeakAtiva() and YOKAI_ROUTE_RANGE or BOSS_SCAN_RANGE
                        local bossList = fastScanNPCs(char, rootPart.Position, bossRange)
                        for _, npc in ipairs(bossList) do
                            local n = string.lower(npc.model.Name)
                            if string.find(n, "the voidborn") or string.find(n, "odin reincarnation") then continue end
                            if string.find(n, "adelys") then
                                if not isAdelysStationary(npc.model) then
                                    continue
                                end
                            end
                            if isBossName(n) then
                                _bossSeenDungeon = _stats.dungeon
                                local dd = (npc.root.Position - rootPart.Position).Magnitude
                                if dd < bossDist then
                                    bossDist = dd
                                    bossTarget = npc
                                    bossPosKey = getBossPosKey(n)
                                end
                            end
                        end
                        if not bossTarget then
                            waypointPos = getArenaWaypoint(rootPart.Position)
                        end
                        -- Adelys presente: depois de matar os NPCs, vai para a localização
                        -- definida e fica parado até o Adelys parar lá. Só dispara quando
                        -- o Adelys está de facto no mapa (evita TP para a posição noutra dungeon).
                        if not bossTarget and not adelysTarget and not normalNPC and not corruptedTarget and adelysPresent then
                            local adelysSpot = BossPositions["Adelys"] and BossPositions["Adelys"].pos
                            if adelysSpot then
                                waypointPos = adelysSpot
                            end
                        end
                    end

                    local closestNPC = nil
                    local closestNPCModel = nil
                    local bossName = nil
                    local targetType = "Normal"
                    local foundCorruptedGrowth = false

                    -- Prioridade: Voidborn > Adelys > Reaver > Normal(próxima zona) > Corrupted
                    if voidbornTarget then
                        closestNPC = voidbornTarget.part
                        closestNPCModel = voidbornTarget.model
                        bossName = "The Voidborn"
                    elseif adelysTarget then
                        closestNPC = adelysTarget.part
                        closestNPCModel = adelysTarget.model
                        bossName = "Adelys"
                    elseif reaverTarget then
                        closestNPC = reaverTarget.part
                        closestNPCModel = reaverTarget.model
                        targetType = "Reaver"
                    elseif greggTarget then
                        closestNPC = greggTarget.part
                        closestNPCModel = greggTarget.model
                        targetType = "Gregg"
                    elseif normalNPC then
                        closestNPC = normalNPC.part
                        closestNPCModel = normalNPC.model
                        targetType = targetTypeNormal
                    elseif bossTarget then
                        closestNPC = bossTarget.root
                        closestNPCModel = bossTarget.model
                        bossName = bossPosKey or "Boss"
                        targetType = "Normal"
                    elseif corruptedTarget then
                        closestNPC = corruptedTarget.part
                        closestNPCModel = corruptedTarget.model
                        targetType = "CorruptedGrowth"
                        foundCorruptedGrowth = true
                    end

                    local npcAlive = false
                    if closestNPC and closestNPCModel then
                        local hum = closestNPCModel:FindFirstChildOfClass("Humanoid")
                        if hum and hum.Health > 0 and closestNPC.Parent and closestNPCModel.Parent then
                            npcAlive = true
                        end
                    end

                    if npcAlive then
                        hadTargets = true
                        currentTargetInfo = {
                            bossName = bossName,
                            closestNPC = closestNPC,
                            closestNPCModel = closestNPCModel,
                            targetType = targetType,
                            isCorruptedGrowth = foundCorruptedGrowth,
                            waypointPos = waypointPos,
                        }
                    else
                        currentTargetInfo = { bossName = nil, closestNPC = nil, closestNPCModel = nil, targetType = nil, isCorruptedGrowth = false, waypointPos = waypointPos }
                    end
                    if tick() - _adelysCleanupAt > 5 then
                        _adelysCleanupAt = tick()
                        cleanupAdelysMotion()
                    end
                else
                    -- ===================== ABYSSAL VOID (idêntico ao testeDQ.lua) =====================
                    local npcList = fastScanNPCs(char, rootPart.Position, NightHub.MaxDetectionRange * 10)

                    local voidbornTarget = nil
                    local adelysTarget = nil
                    local reaverTarget = nil
                    local reaverDist = math.huge
                    local normalNPC = nil
                    local normalDist = math.huge
                    local targetTypeNormal = nil
                    local corruptedTarget = nil
                    local corruptedDist = math.huge
                    local greggTarget = nil
                    local greggDist = math.huge

                    for _, npc in ipairs(npcList) do
                        local model = npc.model
                        local targetPart = npc.root
                        local d = (targetPart.Position - rootPart.Position).Magnitude
                        local nameLower = string.lower(model.Name)

                        if string.find(nameLower, "the voidborn") then
                            voidbornTarget = { model = model, part = targetPart }
                        elseif string.find(nameLower, "adelys") then
                            adelysTarget = { model = model, part = targetPart }
                        elseif isEldritchReaver(model.Name) then
                            if d < reaverDist then
                                reaverDist = d
                                reaverTarget = { model = model, part = targetPart }
                            end
                        elseif isCorruptedGrowth(model.Name) then
                            if d < corruptedDist then
                                corruptedDist = d
                                corruptedTarget = { model = model, part = targetPart }
                            end
                        elseif string.find(nameLower, "gregg") then
                            -- Gregg tem prioridade sobre os NPCs normais: quando spawna,
                            -- o personagem TP para perto dele e desvia dos ataques frontais.
                            if d < greggDist then
                                greggDist = d
                                greggTarget = { model = model, part = targetPart }
                            end
                        else
                            if d < normalDist then
                                normalDist = d
                                normalNPC = { model = model, part = targetPart }

                                if isVoidShade(model.Name) then
                                    targetTypeNormal = "Voidshade"
                                else
                                    targetTypeNormal = "Normal"
                                end
                            end
                        end
                    end

                    local closestNPC = nil
                    local closestNPCModel = nil
                    local bossName = nil
                    local targetType = "Normal"
