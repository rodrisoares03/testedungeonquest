local function getArenaWaypoint(rootPos)
    if _stats.dungeon ~= _bossSeenDungeon then return nil end
    if _stats.dungeon ~= "Yokai Peak" then return nil end
    local entry
    if _yokaiLeonaruMorto then
        entry = BossPositions["Sarugami"]
    else
        entry = BossPositions["Commander Leonaru"]
    end
    if not entry then return nil end
    if (entry.pos - rootPos).Magnitude <= YOKAI_ROUTE_LIMIT then
        return entry.pos
    end
    return nil
end

local function getYokaiTPPos(behindDir, baseOrigin, step)
    local dir = Vector3.new(behindDir.X, 0, behindDir.Z)
    if dir.Magnitude < 0.5 then
        dir = Vector3.new(0, 0, 1)
    end
    dir = dir.Unit
    return baseOrigin + dir * step
end

-- Adelys (Abyssal Void): o jogador mata todos os NPCs primeiro e fica parado
-- na localização definida. O TP só é dado quando o Adelys parar (não persegue
-- o boss em movimento).
local _adelysMotion = {}
local _adelysStopStart = {}
local _adelysCleanupAt = 0

local function isAdelysStationary(model)
    local root = model and (model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart"))
    if not root then return false end
    local now = tick()
    local prev = _adelysMotion[model]
    _adelysMotion[model] = { pos = root.Position, t = now }
    if not prev then return false end
    local dt = now - prev.t
    if dt <= 0 then return false end
    local speed = (root.Position - prev.pos).Magnitude / dt
    if speed < 0.5 then
        _adelysStopStart[model] = _adelysStopStart[model] or now
        return (now - _adelysStopStart[model]) >= 1.2
    end
    _adelysStopStart[model] = nil
    return false
end

local function cleanupAdelysMotion()
    for m, _ in pairs(_adelysMotion) do
        local hum = m and m:FindFirstChildOfClass("Humanoid")
        if not m or not m.Parent or not hum or hum.Health <= 0 then
            _adelysMotion[m] = nil
            _adelysStopStart[m] = nil
        end
    end
end

local _lastLandedCleanupAt = 0
local _targetLandedMotion = {}
local _targetLandedStart = {}
local _outsideMapCache = {}
local _outsideMapCacheTime = {}

local function isNPCOutsideMap(model)
    local root = model and (model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart"))
    if not root then return true end
    local found = false
    pcall(function()
        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        local filter = { model }
        local char = LocalPlayer.Character
        if char then filter[#filter + 1] = char end
        params.FilterDescendantsInstances = filter
        local result = workspace:Raycast(root.Position + Vector3.new(0, 1, 0), Vector3.new(0, -1000, 0), params)
        if result and result.Instance and result.Instance:IsA("BasePart") and result.Instance.CanCollide then
            found = true
        end
    end)
    return not found
end

local function isNPCOutsideMapCached(model)
    if not model then return true end
    local key = model:GetFullName()
    local now = tick()
    local c = _outsideMapCacheTime[key]
    if c and (now - c) < 0.5 then return _outsideMapCache[key] end
    local outside = isNPCOutsideMap(model)
    _outsideMapCache[key] = outside
    _outsideMapCacheTime[key] = now
    return outside
end

local function isTargetLanded(model)
    local root = model and (model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart"))
    if not root then return false end
    local now = tick()
    local prev = _targetLandedMotion[model]
    _targetLandedMotion[model] = { y = root.Position.Y, t = now }
    if not prev then return false end
    local dt = now - prev.t
    if dt <= 0 then return false end
    local vy = math.abs(root.Position.Y - prev.y) / dt
    if vy < 1.5 then
        _targetLandedStart[model] = _targetLandedStart[model] or now
        return (now - _targetLandedStart[model]) >= 0.6
    end
    _targetLandedStart[model] = nil
    return false
end

local function cleanupTargetLanded()
    for m, _ in pairs(_targetLandedMotion) do
        local hum = m and m:FindFirstChildOfClass("Humanoid")
        if not m or not m.Parent or not hum or hum.Health <= 0 then
            local key = m:GetFullName()
            _targetLandedMotion[m] = nil
            _targetLandedStart[m] = nil
            _outsideMapCache[key] = nil
            _outsideMapCacheTime[key] = nil
        end
    end
end

