local function applySafeTeleport(rootPart, pos, lookAt)
    if not rootPart or not pos then return end
    if pos.X ~= pos.X or pos.Y ~= pos.Y or pos.Z ~= pos.Z then return end
    if pos.Y > 1000 or pos.Y < -800 then return end
    if pos.Magnitude > 50000 then return end
    local delta = pos - rootPart.Position
    local maxStep = NightHub.LeapingStepDistance
    if delta.Magnitude > maxStep and delta.Magnitude > 0.5 then
        pos = rootPart.Position + delta.Unit * maxStep
        if pos.Y > 1000 or pos.Y < -800 then return end
        if pos.Magnitude > 50000 then return end
    end
    local lookPt
    if lookAt then
        lookPt = Vector3.new(lookAt.X, pos.Y, lookAt.Z)
        if (pos - lookPt).Magnitude < 0.5 then
            lookPt = pos + Vector3.new(0, 0, 1)
        end
    else
        lookPt = pos + rootPart.CFrame.LookVector
    end
    rootPart.CFrame = CFrame.new(pos, lookPt)
end

