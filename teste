        for cat, rarities in pairs(data.AutoSellSettings) do
            if AutoSellSettings[cat] then
                for rar, val in pairs(rarities) do
                    if AutoSellSettings[cat][rar] ~= nil then
                        AutoSellSettings[cat][rar] = val
                    end
                end
            end
        end
    end

    if type(data.Binds) == "table" then
        for k, v in pairs(data.Binds) do
            if Binds[k] ~= nil then Binds[k] = v end
        end
    end

    -- Aplicar estados de toggle
    local autoRetryApplied = false
    if data.AutoStartAtivo ~= nil then
        NightHub.AutoStartAtivo = data.AutoStartAtivo
        UpdateUIToggle("AutoStart", NightHub.AutoStartAtivo)
        if NightHub.AutoStartAtivo then pcall(iniciarAutoStart) else pcall(pararAutoStart) end
        if NightHub.AutoStartAtivo and data.AutoRetryAtivo then
            autoRetryApplied = true
            NightHub.AutoRetryAtivo = true
            UpdateUIToggle("AutoRetry", NightHub.AutoRetryAtivo)
            pcall(function()
                loadstring(game:HttpGet('https://raw.githubusercontent.com/ValorantIsKewl/RBX/refs/heads/main/DQAutoRetry'))()
            end)
        end
    end
    -- NoVFX executado cedo junto com AutoStart
    if data.NoVFXAtivo ~= nil then
        NightHub.NoVFXAtivo = data.NoVFXAtivo
        UpdateUIToggle("NoVFX", NightHub.NoVFXAtivo)
        if data.NoVFXAtivo then pcall(ativarNoVFX) else pcall(desativarNoVFX) end
    end
    if data.SpammerAtivo ~= nil then
        NightHub.SpammerAtivo = data.SpammerAtivo
        UpdateUIToggle("Spammer", NightHub.SpammerAtivo)
        if NightHub.SpammerAtivo then pcall(iniciarSpammer) else pcall(pararSpammer) end
    end
    if data.FarmAtivo ~= nil then
        local shouldStartFarm = data.FarmAtivo
        NightHub.FarmAtivo = shouldStartFarm
        UpdateUIToggle("Farm", shouldStartFarm)
        FarmLoadToken += 1
        local token = FarmLoadToken
        if shouldStartFarm then
            pcall(pararFarm)
            task.delay(5, function()
                if token == FarmLoadToken then
                    NightHub.FarmAtivo = true
                    pcall(iniciarFarm)
                end
            end)
        else
            pcall(pararFarm)
        end
    end
    if data.FlyAtivo ~= nil then
        NightHub.FlyAtivo = data.FlyAtivo
        UpdateUIToggle("Fly", NightHub.FlyAtivo)
        if NightHub.FlyAtivo then pcall(iniciarFly) else pcall(pararFly) end
    end
    if data.ForceClickAtivo ~= nil then
        NightHub.ForceClickAtivo = data.ForceClickAtivo
        UpdateUIToggle("ForceClick", NightHub.ForceClickAtivo)
    end
    if data.LeapingStrikeTPAtivo ~= nil then
        NightHub.LeapingStrikeTPAtivo = data.LeapingStrikeTPAtivo
        UpdateUIToggle("LeapingStrikeTP", NightHub.LeapingStrikeTPAtivo)
        if NightHub.LeapingStrikeTPAtivo then pcall(iniciarLeapingStrikeTP) else pcall(pararLeapingStrikeTP) end
    end
    if data.AutoFAtivo ~= nil then
        NightHub.AutoFAtivo = data.AutoFAtivo
        UpdateUIToggle("AutoF", NightHub.AutoFAtivo)
        if NightHub.AutoFAtivo then pcall(iniciarAutoF) else pcall(pararAutoF) end
    end
    if data.AutoFSaveConfig ~= nil then NightHub.AutoFSaveConfig = data.AutoFSaveConfig; UpdateUIToggle("AutoFSave", NightHub.AutoFSaveConfig) end
    if data.AutoFDelay ~= nil then NightHub.AutoFDelay = data.AutoFDelay; UpdateSlider("Delay Auto-F", data.AutoFDelay) end
    if data.AutoSellAtivo ~= nil then
        NightHub.AutoSellAtivo = data.AutoSellAtivo
        UpdateUIToggle("AutoSell", NightHub.AutoSellAtivo)
        if NightHub.AutoSellAtivo then pcall(iniciarAutoSell) else pcall(pararAutoSell) end
    end
    if data.AutoRetryAtivo ~= nil and not autoRetryApplied then
        NightHub.AutoRetryAtivo = data.AutoRetryAtivo
        UpdateUIToggle("AutoRetry", NightHub.AutoRetryAtivo)
        if NightHub.AutoRetryAtivo then
            pcall(function()
                loadstring(game:HttpGet('https://raw.githubusercontent.com/ValorantIsKewl/RBX/refs/heads/main/DQAutoRetry'))()
            end)
        end
    end
    if data.VelocidadeExtra ~= nil then
        UpdateUIToggle("Speed", data.VelocidadeExtra)
        if data.VelocidadeExtra then pcall(ativarVelocidadeExtra) else pcall(desativarVelocidadeExtra) end
    end
    if data.LimboAltura ~= nil then NightHub.LimboAltura = data.LimboAltura end
    if data.LimboSafeRefresh ~= nil then NightHub.LimboSafeRefresh = data.LimboSafeRefresh end
    if data.LimboAtivo ~= nil then
        NightHub.LimboAtivo = data.LimboAtivo
        UpdateUIToggle("Limbo", NightHub.LimboAtivo)
        if NightHub.LimboAtivo then pcall(iniciarLimbo) else pcall(pararLimbo) end
    end
    
    -- Atualiza visual dos botões de raridade na aba Sell
    for catKey, _ in pairs(AutoSellSettings) do
        for rarKey, _ in pairs(AutoSellSettings[catKey]) do
            atualizarBotaoRaridade(catKey, rarKey)
        end
    end
    
    refreshAllTextLabels()
end

